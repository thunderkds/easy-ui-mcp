{
  "name": "easy-ui-mcp",
  "version": "0.1.0",
  "description": "Local UI-testing MCP server: Dockerized Playwright tools for AI agents, with a structured JSON + HTML report (screenshots, step labels, pass/fail) for every session.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "appium": "2.11.4",
    "express": "^5.2.1",
    "playwright": "1.61.1",
    "webdriverio": "9.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
